{
  "name": "effect-views",
  "version": "0.1.0",
  "private": true,
  "description": "An unfinished experiment in server-rendered HTML and schema-bound forms with Effect v4",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.0",
  "exports": {
    ".": {
      "effect-views-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./Assets": {
      "effect-views-source": "./src/Assets.ts",
      "types": "./dist/Assets.d.ts",
      "default": "./dist/Assets.js"
    },
    "./Component": {
      "effect-views-source": "./src/Component.ts",
      "types": "./dist/Component.d.ts",
      "default": "./dist/Component.js"
    },
    "./Csp": {
      "effect-views-source": "./src/Csp.ts",
      "types": "./dist/Csp.d.ts",
      "default": "./dist/Csp.js"
    },
    "./Csrf": {
      "effect-views-source": "./src/Csrf.ts",
      "types": "./dist/Csrf.d.ts",
      "default": "./dist/Csrf.js"
    },
    "./ErrorPage": {
      "effect-views-source": "./src/ErrorPage.ts",
      "types": "./dist/ErrorPage.d.ts",
      "default": "./dist/ErrorPage.js"
    },
    "./Form": {
      "effect-views-source": "./src/Form.ts",
      "types": "./dist/Form.d.ts",
      "default": "./dist/Form.js"
    },
    "./Html": {
      "effect-views-source": "./src/Html.ts",
      "types": "./dist/Html.d.ts",
      "default": "./dist/Html.js"
    },
    "./HttpFormEndpoint": {
      "effect-views-source": "./src/HttpFormEndpoint.ts",
      "types": "./dist/HttpFormEndpoint.d.ts",
      "default": "./dist/HttpFormEndpoint.js"
    },
    "./HttpViewEndpoint": {
      "effect-views-source": "./src/HttpViewEndpoint.ts",
      "types": "./dist/HttpViewEndpoint.d.ts",
      "default": "./dist/HttpViewEndpoint.js"
    },
    "./LiveAction": {
      "effect-views-source": "./src/LiveAction.ts",
      "types": "./dist/LiveAction.d.ts",
      "default": "./dist/LiveAction.js"
    },
    "./LiveComponent": {
      "effect-views-source": "./src/LiveComponent.ts",
      "types": "./dist/LiveComponent.d.ts",
      "default": "./dist/LiveComponent.js"
    },
    "./On": {
      "effect-views-source": "./src/On.ts",
      "types": "./dist/On.d.ts",
      "default": "./dist/On.js"
    },
    "./Page": {
      "effect-views-source": "./src/Page.ts",
      "types": "./dist/Page.d.ts",
      "default": "./dist/Page.js"
    },
    "./Submission": {
      "effect-views-source": "./src/Submission.ts",
      "types": "./dist/Submission.d.ts",
      "default": "./dist/Submission.js"
    },
    "./View": {
      "effect-views-source": "./src/View.ts",
      "types": "./dist/View.d.ts",
      "default": "./dist/View.js"
    },
    "./jsx-runtime": {
      "effect-views-source": "./src/jsx-runtime.ts",
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "effect-views-source": "./src/jsx-dev-runtime.ts",
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    }
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b src examples",
    "build:lib": "tsc -b src",
    "check": "tsc -b",
    "clean": "tsc -b --clean && rm -rf .tsbuildinfo dist dist-examples dist-test",
    "dev": "pnpm build && tsx --tsconfig examples/tsconfig.json --watch examples/orders/main.tsx",
    "example": "pnpm example:orders",
    "example:orders": "pnpm build && node dist-examples/orders/main.js",
    "example:signup": "pnpm build && node dist-examples/signup/main.js",
    "example:todo": "pnpm build && node dist-examples/todo-list/main.js",
    "example:todo:cli": "pnpm build && node dist-examples/todo-list/cli.js",
    "test": "pnpm build:lib && vitest run"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0",
    "@effect/sql-sqlite-node": "4.0.0",
    "@effect/vitest": "4.0.0",
    "@types/node": "26.1.2",
    "effect": "4.0.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
